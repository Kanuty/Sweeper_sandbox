[node name="InstructionsLabel" type="RichTextLabel" parent="HowToPlayModal/Panel/VBoxContainer/ScrollContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
bbcode_enabled = true
text = "[b]Goal:[/b]
Stay alive as long as possible by making balanced decisions.

[b]Indicators (Top Panel):[/b]
• 4 resources start at default value [color=yellow]50[/color] (min 0, max 100).
• [color=crimson]Game Over[/color] occurs if ANY indicator reaches [color=red]0[/color] or [color=red]100[/color]!

[b]Controls & Swiping:[/b]
• Swipe cards [b]LEFT, RIGHT, UP, or DOWN[/b] (or use Keyboard Arrow Keys / On-screen Direction Buttons).
• As you drag, glowing markers show WHICH top indicators will be affected by that direction.
• You will see which indicators will change, but NOT how much or in which direction!"

