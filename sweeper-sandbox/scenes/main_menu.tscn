[node name="InstructionsLabel" type="RichTextLabel" parent="HowToPlayModal/Panel/VBoxContainer/ScrollContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
bbcode_enabled = true
text = "[b]Goal:[/b]
Survive as many [b]Days & Hours[/b] as possible while balancing Food 🍞, Treasury 💰, Environment 🌿, and Tech ⚡!

[b]Features:[/b]
• [b]Vague Meters:[/b] Progress bars show level without exact numbers unless Insights are active.
• [b]Typewriter Effect:[/b] Story cards reveal text animated letter-by-letter. Tap to skip!
• [b]Doom Stories:[/b] Upon failure, read a 2-card post-mortem sequence of your colony's demise before the final score.
• [b]High Scores & Achievements:[/b] Track top runs and unlock achievements!"

